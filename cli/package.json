{
  "name": "@commercetools-demo/wd",
  "version": "0.1.1",
  "description": "Hand a Claude Code assignment to GitHub Actions when your own quota is gone",
  "keywords": [
    "claude",
    "claude-code",
    "github-actions",
    "cli",
    "automation",
    "repository-dispatch"
  ],
  "homepage": "https://github.com/commercetools-demo/workload-dispatcher#readme",
  "bugs": {
    "url": "https://github.com/commercetools-demo/workload-dispatcher/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercetools-demo/workload-dispatcher.git",
    "directory": "cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "wd": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node scripts/embed-workflow.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "node scripts/embed-workflow.mjs && tsx src/cli.ts",
    "e2e": "../scripts/e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
